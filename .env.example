PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# JWT signing secrets — use strong random values, rotate before deploying to production
JWT_SECRET=change_me_random_string
JWT_ACCESS_SECRET=change_me_strong_access_secret
JWT_REFRESH_SECRET=change_me_strong_refresh_secret
NODE_ENV=development
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Frontend origin(s) allowed by CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:3000
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Razorpay payment keys (primary config — set these in .env)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA AI (doubt forum auto-reply)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Optional SMTP mail transport (nodemailer) — used for Brevo, SendGrid, etc.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change_me
# SMTP_SECURE=false
# MAIL_FROM=no-reply@example.com

# Email Verification
# EMAIL_VERIFICATION_EXPIRES_MS=86400000 (24h in ms)

# Google OAuth 2.0 — obtain credentials from Google Cloud Console
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Allowed email domains for registration (comma-separated)
# ALLOWED_EMAIL_DOMAINS=gmail.com,yahoo.com,yahoo.co.in,outlook.com,hotmail.com,live.com,icloud.com,proton.me,protonmail.com,zoho.com,rediffmail.com,gmx.com,aol.com

# Render.com keep-alive (prevent free-tier sleep). Set to your public Render URL on deployment.
# KEEPALIVE_URL=https://your-app.onrender.com
# KEEPALIVE_INTERVAL_MS=600000